#!/bin/sh

CONFIG_FILE="/etc/marvin.conf"
LOCK_FILE="/var/lock/marvin/instance.lock"
FLOCK_BIN="/usr/bin/flock"
ADMIN_UID="0"

PATH="/usr/local/bin:/usr/bin:/bin"
export PATH
unset CDPATH ENV BASH_ENV NODE_OPTIONS LD_PRELOAD LD_LIBRARY_PATH
unset PI_CODING_AGENT_DIR PI_CODING_AGENT_SESSION_DIR PI_PACKAGE_DIR
unset PI_OFFLINE PI_SKIP_VERSION_CHECK PI_TELEMETRY
umask 077

fail() {
  printf '%s\n' "Marvin cannot start: $1." >&2
  exit 1
}

is_admin_controlled() {
  path=$1

  [ ! -L "$path" ] || return 1
  [ -e "$path" ] || return 1

  owner=$(stat -Lc '%u' "$path" 2>/dev/null) || return 1
  permissions=$(stat -Lc '%A' "$path" 2>/dev/null) || return 1
  [ "$owner" = "$ADMIN_UID" ] || return 1

  case "$permissions" in
    ?????w????|????????w?) return 1 ;;
  esac

  return 0
}

canonical_directory() {
  (
    CDPATH=
    cd -P "$1" 2>/dev/null || exit 1
    pwd -P
  )
}

[ -t 0 ] && [ -t 1 ] || {
  printf '%s\n' 'Marvin requires an interactive SSH terminal.' >&2
  exit 1
}

[ -z "${SSH_ORIGINAL_COMMAND:-}" ] || {
  printf '%s\n' 'Marvin does not accept remote commands.' >&2
  exit 1
}

current_uid=$(id -u 2>/dev/null) || fail 'account identity unavailable'
[ "$current_uid" -ne 0 ] || fail 'a dedicated non-root account is required'

case "${HOME:-}" in
  /*) ;;
  *) fail 'HOME must be an absolute directory' ;;
esac
[ -d "$HOME" ] || fail 'HOME is unavailable'
home_owner=$(stat -Lc '%u' "$HOME" 2>/dev/null) || fail 'HOME is unavailable'
[ "$home_owner" = "$current_uid" ] || fail 'HOME has the wrong owner'

config_parent=${CONFIG_FILE%/*}
is_admin_controlled "$config_parent" || fail 'configuration parent is not administrator-controlled'
is_admin_controlled "$CONFIG_FILE" || fail 'configuration is missing or insecure'
[ -f "$CONFIG_FILE" ] && [ -r "$CONFIG_FILE" ] || fail 'configuration is unavailable'

unset MARVIN_WORKSPACE MARVIN_SESSION_DIR MARVIN_NODE_BIN
# shellcheck disable=SC1090
. "$CONFIG_FILE"

case "${MARVIN_WORKSPACE:-}" in
  /*) ;;
  *) fail 'MARVIN_WORKSPACE must be an absolute directory' ;;
esac
[ -d "$MARVIN_WORKSPACE" ] && [ -r "$MARVIN_WORKSPACE" ] && [ -x "$MARVIN_WORKSPACE" ] ||
  fail 'MARVIN_WORKSPACE is unavailable'
workspace=$(canonical_directory "$MARVIN_WORKSPACE") || fail 'MARVIN_WORKSPACE is unavailable'

session_dir=${MARVIN_SESSION_DIR:-"$HOME/.pi/agent/marvin/sessions"}
case "$session_dir" in
  /*) ;;
  *) fail 'MARVIN_SESSION_DIR must be an absolute directory' ;;
esac

if [ ! -e "$session_dir" ]; then
  mkdir -p -m 700 "$session_dir" 2>/dev/null || fail 'MARVIN_SESSION_DIR cannot be created'
  chmod 700 "$session_dir" 2>/dev/null || fail 'MARVIN_SESSION_DIR permissions cannot be set'
fi

[ ! -L "$session_dir" ] || fail 'MARVIN_SESSION_DIR must not be a symbolic link'
[ -d "$session_dir" ] && [ -r "$session_dir" ] && [ -w "$session_dir" ] && [ -x "$session_dir" ] ||
  fail 'MARVIN_SESSION_DIR is unavailable'
session_owner=$(stat -Lc '%u' "$session_dir" 2>/dev/null) || fail 'MARVIN_SESSION_DIR is unavailable'
[ "$session_owner" = "$current_uid" ] || fail 'MARVIN_SESSION_DIR has the wrong owner'
session_mode=$(stat -Lc '%a' "$session_dir" 2>/dev/null) || fail 'MARVIN_SESSION_DIR is unavailable'
case "$session_mode" in
  *00) ;;
  *) fail 'MARVIN_SESSION_DIR must not grant group or other permissions' ;;
esac
session_dir=$(canonical_directory "$session_dir") || fail 'MARVIN_SESSION_DIR is unavailable'

case "${MARVIN_NODE_BIN:-}" in
  /*) ;;
  *) fail 'MARVIN_NODE_BIN must be an absolute executable path' ;;
esac
[ -f "$MARVIN_NODE_BIN" ] && [ -x "$MARVIN_NODE_BIN" ] || fail 'MARVIN_NODE_BIN is unavailable'
node_bin=$(realpath -e "$MARVIN_NODE_BIN" 2>/dev/null) || fail 'MARVIN_NODE_BIN is unavailable'
"$node_bin" -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 19)) process.exit(1);
' 2>/dev/null || fail 'MARVIN_NODE_BIN must provide Node 22.19.0 or newer'

script_path=$(realpath -e "$0" 2>/dev/null) || fail 'launcher path is unavailable'
release_root=${script_path%/bin/marvin}
[ "$release_root" != "$script_path" ] || fail 'launcher is outside the release layout'
pi_cli="$release_root/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
system_prompt="$release_root/config/system-prompt.md"
[ -f "$pi_cli" ] && [ -r "$pi_cli" ] || fail 'pinned Pi CLI is unavailable'
[ -f "$system_prompt" ] && [ -r "$system_prompt" ] || fail 'Marvin system prompt is unavailable'

[ -x "$FLOCK_BIN" ] || fail 'util-linux flock is unavailable'
"$FLOCK_BIN" --version 2>/dev/null | grep -q 'util-linux' || fail 'util-linux flock is unavailable'

lock_parent=${LOCK_FILE%/*}
is_admin_controlled "$lock_parent" || fail 'instance lock parent is not administrator-controlled'
is_admin_controlled "$LOCK_FILE" || fail 'instance lock is missing or insecure'
[ -f "$LOCK_FILE" ] && [ -r "$LOCK_FILE" ] || fail 'instance lock is unavailable'

exec 9<"$LOCK_FILE" || fail 'instance lock is unavailable'
if "$FLOCK_BIN" --exclusive --nonblock --conflict-exit-code 75 9; then
  :
else
  lock_status=$?
  if [ "$lock_status" -eq 75 ]; then
    printf '%s\n' 'Marvin is already active.' >&2
    exit 75
  fi
  fail 'instance lock is unavailable'
fi

cd "$workspace" || fail 'MARVIN_WORKSPACE is unavailable'
unset MARVIN_WORKSPACE MARVIN_SESSION_DIR MARVIN_NODE_BIN SSH_ORIGINAL_COMMAND

exec "$node_bin" "$pi_cli" \
  --continue \
  --session-dir "$session_dir" \
  --tools read,bash,grep,find,ls \
  --system-prompt "$system_prompt"

fail 'pinned Pi CLI could not be started'
